# Enable RewriteEngine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/

    # Allow CORS headers on all requests
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"

    # Route /api/shop/categories to shop_categories.php
    RewriteRule ^shop/categories/?$ shop_categories.php [L,QSA]
    RewriteRule ^shop/categories\.php/?$ shop_categories.php [L,QSA]

    # Route /api/wishlist to wishlist.php
    RewriteRule ^wishlist/?$ wishlist.php [L,QSA]

    # Route /api/category/:slug/products to category_products.php
    RewriteRule ^category/([^/]+)/products/?$ category_products.php?slug=$1 [L,QSA]

    # Route /api/products/:id/detail to product_detail.php
    RewriteRule ^products/([^/]+)/detail/?$ product_detail.php?action=app_detail&id=$1 [L,QSA]

    # Route /api/admin/products/:id/detail to product_detail.php
    RewriteRule ^admin/products/([^/]+)/detail/?$ product_detail.php?action=admin_detail&id=$1 [L,QSA]

    # Route /api/admin/products/:id/photos to product_detail.php
    RewriteRule ^admin/products/([^/]+)/photos/?$ product_detail.php?action=admin_photos&id=$1 [L,QSA]

    # Route /api/admin/products/:id/photos/:photoId to product_detail.php
    RewriteRule ^admin/products/([^/]+)/photos/([^/]+)/?$ product_detail.php?action=admin_photo_item&id=$1&photoId=$2 [L,QSA]

    # Route /api/admin/products/analytics/views to product_detail.php
    RewriteRule ^admin/products/analytics/views/?$ product_detail.php?action=analytics_views [L,QSA]

    # Route /api/profile/me to profile.php
    RewriteRule ^profile/me/?$ profile.php [L,QSA]
    RewriteRule ^profile/?$ profile.php [L,QSA]
</IfModule>

