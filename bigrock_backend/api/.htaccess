# Enable RewriteEngine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/

    # Allow CORS headers on all requests
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"

    # Route /api/shop/categories to shop_categories.php
    RewriteRule ^shop/categories/?$ shop_categories.php [L,QSA]
    RewriteRule ^shop/categories\.php/?$ shop_categories.php [L,QSA]

    # Route /api/wishlist to wishlist.php
    RewriteRule ^wishlist/?$ wishlist.php [L,QSA]

    # Route /api/category/:slug/products to category_products.php
    RewriteRule ^category/([^/]+)/products/?$ category_products.php?slug=$1 [L,QSA]

    # Route /api/products/:id/detail to product_detail.php
    RewriteRule ^products/([^/]+)/detail/?$ product_detail.php?action=app_detail&id=$1 [L,QSA]

    # Route /api/admin/products/:id/detail to product_detail.php
    RewriteRule ^admin/products/([^/]+)/detail/?$ product_detail.php?action=admin_detail&id=$1 [L,QSA]

    # Route /api/admin/products/:id/photos to product_detail.php
    RewriteRule ^admin/products/([^/]+)/photos/?$ product_detail.php?action=admin_photos&id=$1 [L,QSA]

    # Route /api/admin/products/:id/photos/:photoId to product_detail.php
    RewriteRule ^admin/products/([^/]+)/photos/([^/]+)/?$ product_detail.php?action=admin_photo_item&id=$1&photoId=$2 [L,QSA]

    # Route /api/admin/products/analytics/views to product_detail.php
    RewriteRule ^admin/products/analytics/views/?$ product_detail.php?action=analytics_views [L,QSA]

    # Route /api/profile/me to profile.php
    RewriteRule ^profile/me/?$ profile.php [L,QSA]
    RewriteRule ^profile/?$ profile.php [L,QSA]

    # Route Auth & Login endpoints to auth.php
    RewriteRule ^auth/login-config/?$ auth.php?action=login_config [L,QSA]
    RewriteRule ^auth/send-otp/?$ auth.php?action=send_otp [L,QSA]
    RewriteRule ^auth/verify-otp/?$ auth.php?action=verify_otp [L,QSA]
    RewriteRule ^admin/login-settings/?$ auth.php?action=admin_login_settings [L,QSA]
    RewriteRule ^admin/login-wall/([0-9]+)/?$ auth.php?action=admin_login_wall_item&id=$1 [L,QSA]
    RewriteRule ^admin/login-wall/?$ auth.php?action=admin_login_wall [L,QSA]

    # Route Showcase Section endpoints to showcase.php
    RewriteRule ^showcase/([^/]+)/?$ showcase.php?action=public_showcase&key=$1 [L,QSA]
    RewriteRule ^admin/showcase/([^/]+)/settings/?$ showcase.php?action=admin_settings&key=$1 [L,QSA]
    RewriteRule ^admin/showcase/([^/]+)/items/?$ showcase.php?action=admin_items&key=$1 [L,QSA]
    RewriteRule ^admin/showcase/([^/]+)/order/?$ showcase.php?action=admin_order&key=$1 [L,QSA]
    RewriteRule ^admin/showcase-items/([0-9]+)/?$ showcase.php?action=admin_item_single&id=$1 [L,QSA]
    RewriteRule ^admin/showcase-upload/?$ showcase.php?action=admin_upload [L,QSA]

    # Route Home Most Loved endpoints
    RewriteRule ^home/most-loved/?$ app_settings.php?doc_id=most_loved [L,QSA]
    RewriteRule ^most-loved/?$ app_settings.php?doc_id=most_loved [L,QSA]

    # Route Home Best Sellers endpoints
    RewriteRule ^home/best-sellers/?$ best_sellers.php?action=home [L,QSA]
    RewriteRule ^best-sellers/?$ best_sellers.php?action=tab [L,QSA]
    RewriteRule ^admin/best-sellers/settings/?$ best_sellers.php?action=admin_settings [L,QSA]
    RewriteRule ^admin/best-sellers/tabs/order/?$ best_sellers.php?action=admin_tabs_order [L,QSA]
    RewriteRule ^admin/best-sellers/tabs/([0-9]+)/products/([^/]+)/?$ best_sellers.php?action=admin_override&tabId=$1&productId=$2 [L,QSA]
    RewriteRule ^admin/best-sellers/tabs/([0-9]+)/order/?$ best_sellers.php?action=admin_tab_products_order&tabId=$1 [L,QSA]
    RewriteRule ^admin/best-sellers/tabs/([0-9]+)/?$ best_sellers.php?action=admin_delete_tab&id=$1 [L,QSA]
    RewriteRule ^admin/best-sellers/tabs/?$ best_sellers.php?action=admin_save_tab [L,QSA]
    RewriteRule ^admin/best-sellers/refresh/?$ best_sellers.php?action=admin_refresh [L,QSA]
    RewriteRule ^admin/best-sellers/?$ best_sellers.php?action=admin_get [L,QSA]

    # Route Ambhujakshi Specials (Lotus Eye) endpoints
    RewriteRule ^specials/?$ specials.php?action=public_specials [L,QSA]
    RewriteRule ^admin/specials/settings/?$ specials.php?action=admin_settings [L,QSA]
    RewriteRule ^admin/specials-order/?$ specials.php?action=admin_order [L,QSA]
    RewriteRule ^admin/specials-upload/?$ specials.php?action=admin_upload [L,QSA]
    RewriteRule ^admin/specials/([0-9]+)/?$ specials.php?action=admin_item&id=$1 [L,QSA]
    RewriteRule ^admin/specials/?$ specials.php?action=admin_specials [L,QSA]

    # Route The Art of Pairing endpoints
    RewriteRule ^pairing/?$ pairing.php?action=public_pairing [L,QSA]
    RewriteRule ^admin/pairing/settings/?$ pairing.php?action=admin_settings [L,QSA]
    RewriteRule ^admin/pairing/order/?$ pairing.php?action=admin_order [L,QSA]
    RewriteRule ^admin/pairing/upload/?$ pairing.php?action=admin_upload [L,QSA]
    RewriteRule ^admin/pairing/couples/([0-9]+)/?$ pairing.php?action=admin_item&id=$1 [L,QSA]
    RewriteRule ^admin/pairing/couples/?$ pairing.php?action=admin_couples [L,QSA]
</IfModule>

